# Project Atlas — environment variable template
# Copy to .env and fill in real values locally. Never commit a real .env file.
# Every value below is a placeholder. See TECH.md for the status of each integration.

# --- Database (TECH.md §6 — Confirmed: PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/project_atlas_dev

# --- Backend API ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string

# --- Auth (TECH.md §7 — Google OAuth confirmed; email fallback provider TBD) ---
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# --- Code Execution Service (TECH.md §9 — PROVISIONAL, managed-vs-self-hosted not yet decided) ---
# If a managed execution API is chosen:
CODE_EXECUTION_API_URL=https://replace-with-provider-url.example.com
CODE_EXECUTION_API_KEY=replace-with-provider-api-key
# If self-hosted, these replace the two above instead (keep only the set that applies once decided):
# CODE_EXECUTION_INTERNAL_URL=http://execution-service.internal:8080
# CODE_EXECUTION_SERVICE_SHARED_SECRET=replace-with-service-to-service-shared-secret

# --- AI Hint Service (TECH.md §8 — PROVISIONAL, provider TBD) ---
AI_HINT_PROVIDER_API_KEY=replace-with-llm-provider-api-key
AI_HINT_DAILY_CALL_CAP_PER_USER=20

# --- Observability (docs/engineering/OBSERVABILITY.md — TBD) ---
# ERROR_TRACKING_DSN=replace-if-an-error-tracking-provider-is-chosen
LOG_LEVEL=info
